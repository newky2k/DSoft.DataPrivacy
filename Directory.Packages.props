<Project>
  <!-- Microsoft.* runtime packages follow the target framework: 10.x for net10.0, 11.x for net11.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.8.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
