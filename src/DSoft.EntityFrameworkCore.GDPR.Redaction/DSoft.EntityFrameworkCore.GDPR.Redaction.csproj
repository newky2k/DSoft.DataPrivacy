<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Maps GDPR personal-data categories onto Microsoft.Extensions.Compliance data classifications, so logs redact personal and special category data by the same classification used to describe the database.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSoft.EntityFrameworkCore.GDPR.Abstractions\DSoft.EntityFrameworkCore.GDPR.Abstractions.csproj" />
  </ItemGroup>

</Project>
