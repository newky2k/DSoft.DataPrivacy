<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>GDPR tooling for Entity Framework Core: classify personal data with attributes or the fluent API, then inventory it, export it for a subject access request, erase or anonymise it, apply retention policies and record changes to it.</Description>
    <PackageReleaseNotes>v1.0 - Conventions, fluent API, subject access export, erasure, retention and change log. Supports .NET 8 and .NET 10.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSoft.EntityFrameworkCore.GDPR.Abstractions\DSoft.EntityFrameworkCore.GDPR.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>


</Project>
