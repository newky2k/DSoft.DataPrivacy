<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Maps personal-data categories onto Microsoft.Extensions.Compliance data classifications, so logs redact personal and special category data by the same classification used to describe the database.</Description>
    <PackageReleaseNotes>v1.0 - Log redaction by personal-data category. Supports .NET 8 and .NET 10.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSoft.DataPrivacy\DSoft.DataPrivacy.csproj" />
  </ItemGroup>

</Project>
